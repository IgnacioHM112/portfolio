---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---
<Layout title="Blog • Ignacio Mello">
  <main class="flex-1 px-6 py-16 max-w-3xl mx-auto w-full">
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold mb-2">Blog técnico</h1>
      <p class="text-slate-600 dark:text-slate-300">
        Escribo sobre arquitectura, debugging, herramientas y decisiones técnicas.
      </p>
    </header>

    <div class="space-y-8">
      {posts.map(post => (
        <article class="border-b border-slate-200 dark:border-slate-800 pb-8 last:border-0">
          <time class="text-sm text-slate-500 dark:text-slate-400" datetime={post.data.pubDate}>
            {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h2 class="text-xl font-bold mt-1 mb-2"><a href={`/blog/${post.slug}`} class="hover:underline">{post.data.title}</a></h2>
          <p class="text-slate-600 dark:text-slate-300 mb-3">{post.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map(tag => <span class="px-2 py-0.5 text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="text-center text-slate-500 dark:text-slate-400 py-12">Próximamente artículos...</p>
    )}
  </main>
</Layout>