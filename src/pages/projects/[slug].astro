---
// src/pages/projects/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getProjects, type Project } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { data: project },
  }));
}

interface Props {
  data: Project;
}

const { data } = Astro.props;

const categoryLabels: Record<string, string> = {
  fullstack: 'Fullstack',
  backend: 'Backend & API',
  mobile: 'Mobile App',
  frontend: 'Frontend',
  devops: 'DevOps',
};
---
<Layout title={`${data.title} • Ignacio Mello`} description={data.description}>
  <article class="flex-1 px-6 py-14 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 hover:text-emerald-500 transition"
      >
        ← Volver a todos los proyectos
      </a>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 rounded-full">
          {categoryLabels[data.category] || data.category}
        </span>
        {data.status && (
          <span class="px-3 py-1 text-xs font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            {data.status}
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-3">
        {data.title}
      </h1>
      {data.subtitle && (
        <p class="text-sm font-mono text-emerald-600 dark:text-emerald-400 mb-4">
          {data.subtitle}
        </p>
      )}
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {data.description}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3.5 mt-7">
        <a
          href={data.repo}
          target="_blank"
          rel="noopener"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-600 text-white font-semibold text-sm shadow-md shadow-emerald-500/20 hover:opacity-95 transition flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
          </svg>
          {data.repoFront ? 'Repositorio Backend' : 'Ver código en GitHub'}
        </a>
        {data.repoFront && (
          <a
            href={data.repoFront}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100 font-semibold text-sm hover:border-emerald-500/50 transition flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
            </svg>
            Repositorio Frontend
          </a>
        )}
        {data.demo && (
          <a
            href={data.demo}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 font-semibold text-sm hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center gap-2"
          >
            Ver Demo en vivo ↗
          </a>
        )}
      </div>
    </header>

    {data.image && (
      <div class="mb-10 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-lg">
        <img src={data.image} alt={data.title} class="w-full object-cover max-h-96" />
      </div>
    )}

    <!-- Metrics Banner -->
    {data.metrics && data.metrics.length > 0 && (
      <section class="grid gap-4 sm:grid-cols-3 mb-10">
        {data.metrics.map((metric) => (
          <div class="p-4 rounded-xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-start gap-3">
            <span class="text-emerald-500 font-bold text-lg leading-none mt-0.5">⚡</span>
            <span class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 leading-snug">{metric}</span>
          </div>
        ))}
      </section>
    )}

    <!-- Long Description / Architecture Overview -->
    {data.longDescription && (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
          Arquitectura y Propósito del Sistema
        </h2>
        <div class="prose-custom bg-white dark:bg-slate-900/50 p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
          {data.longDescription.split('\n\n').map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>
    )}

    <!-- Technical Highlights -->
    {data.highlights && data.highlights.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
          Destacados de Ingeniería
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {data.highlights.map((h) => (
            <li class="p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
              <span class="text-emerald-500 font-mono font-bold mt-0.5">→</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Tech Stack -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
        Stack Tecnológico Utilizado
      </h2>
      <div class="flex flex-wrap gap-2">
        {data.stack.map((tech) => (
          <span class="px-3.5 py-1.5 text-xs font-mono font-medium bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-lg border border-slate-200 dark:border-slate-700">
            {tech}
          </span>
        ))}
      </div>
    </section>
  </article>
</Layout>