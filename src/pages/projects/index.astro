---
// src/pages/projects/index.astro
import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../utils/projects';

const projects = await getProjects();

const categoryLabels: Record<string, string> = {
  fullstack: 'Fullstack',
  backend: 'Backend & API',
  mobile: 'Mobile App',
  frontend: 'Frontend',
  devops: 'DevOps',
};

const filterCategories = [
  { key: 'fullstack', label: 'Fullstack' },
  { key: 'backend', label: 'Backend & APIs' },
  { key: 'mobile', label: 'Mobile' },
  { key: 'frontend', label: 'Frontend' },
  { key: 'devops', label: 'DevOps' },
]
  .map((cat) => ({
    ...cat,
    count: projects.filter((p) => p.category === cat.key).length,
  }))
  .filter((cat) => cat.count > 0);
---
<Layout
  title="Proyectos • Ignacio Mello"
  description="Proyectos destacados y fijados en GitHub por Ignacio Mello: sistemas de gestión con IA, plataformas fullstack, e-commerce y apps móviles offline-first."
>
  <main class="flex-1 px-6 py-14 max-w-6xl mx-auto w-full">
    <header class="mb-10">
      <span class="text-xs font-mono uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold">
        Repositorios Fijados &amp; Casos de Estudio
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mt-1 mb-3">
        Proyectos de Ingeniería
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl text-base leading-relaxed">
        Selección de mis proyectos destacados y fijados en <a href="https://github.com/IgnacioHM112" target="_blank" rel="noopener" class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">GitHub (@IgnacioHM112)</a>: sistemas en uso real con visión IA, plataformas fullstack, e-commerce y apps móviles offline-first.
      </p>
    </header>

    <!-- Filtros Interactivos -->
    <div class="flex flex-wrap items-center gap-2.5 mb-10" role="group" aria-label="Filtrar por categoría">
      <button
        class="filter-btn active-filter px-4 py-2 rounded-xl bg-emerald-500 text-slate-950 text-xs font-mono font-bold shadow-sm transition-all"
        data-filter="all"
      >
        Todos ({projects.length})
      </button>
      {filterCategories.map((cat) => (
        <button
          class="filter-btn px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium hover:border-emerald-500/40 transition-all"
          data-filter={cat.key}
        >
          {cat.label} ({cat.count})
        </button>
      ))}
    </div>

    <!-- Grid de Proyectos -->
    <div class="grid gap-6 md:grid-cols-2" id="projects-grid">
      {projects.map((project) => (
        <article
          class="project-card group flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900/75 border border-slate-200/90 dark:border-slate-800/90 transition-all duration-300 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 hover:shadow-xl hover:shadow-emerald-500/5"
          data-category={project.category}
        >
          <div>
            {project.image && (
              <a href={`/projects/${project.slug}`} class="block overflow-hidden rounded-xl mb-5 border border-slate-200 dark:border-slate-800">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </a>
            )}

            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-3 py-1 text-xs font-mono font-medium rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
                {categoryLabels[project.category] || project.category}
              </span>
              {project.status && (
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  {project.status}
                </span>
              )}
            </div>

            <h2 class="font-bold text-xl text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-1.5">
              <a href={`/projects/${project.slug}`}>{project.title}</a>
            </h2>

            {project.subtitle && (
              <p class="text-xs font-mono text-emerald-700 dark:text-emerald-400/90 mb-3">
                {project.subtitle}
              </p>
            )}

            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-5">
              {project.description}
            </p>

            {project.metrics && project.metrics.length > 0 && (
              <ul class="space-y-1.5 mb-5 text-xs text-slate-600 dark:text-slate-400 bg-slate-50 dark:bg-slate-950/60 p-3.5 rounded-xl border border-slate-200/60 dark:border-slate-800/70">
                {project.metrics.map((m) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-500 font-bold">✓</span>
                    <span>{m}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {project.stack.map((tech) => (
                <span class="px-2.5 py-1 text-xs font-mono bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md border border-slate-200/80 dark:border-slate-700/70">
                  {tech}
                </span>
              ))}
            </div>

            <div class="pt-4 border-t border-slate-200/70 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs font-semibold">
              <a
                href={`/projects/${project.slug}`}
                class="text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1"
              >
                Ver caso de estudio →
              </a>
              <div class="flex items-center gap-4">
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener"
                  class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition"
                >
                  {project.repoFront ? 'Código Backend ↗' : 'Código en GitHub ↗'}
                </a>
                {project.repoFront && (
                  <a
                    href={project.repoFront}
                    target="_blank"
                    rel="noopener"
                    class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition"
                  >
                    Código Frontend ↗
                  </a>
                )}
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener"
                    class="text-emerald-600 dark:text-emerald-400 hover:underline"
                  >
                    Demo ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'border', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-medium');
        });
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'border', 'border-slate-200', 'dark:border-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-medium');
        btn.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold');
        const filter = btn.dataset.filter;
        cards.forEach((card) => {
          card.style.display = filter === 'all' || card.dataset.category === filter ? 'flex' : 'none';
        });
      });
    });
  </script>
</Layout>