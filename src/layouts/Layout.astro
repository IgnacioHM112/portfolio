---
// src/layouts/Layout.astro
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Ignacio Mello • Desarrollador Backend & Fullstack (Node.js, React, MySQL, TypeScript, Docker) en Mendoza, Argentina.',
} = Astro.props;

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/projects', label: 'Proyectos' },
  { href: '/about', label: 'Sobre mí' },
  { href: '/blog', label: 'Blog' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---
<!doctype html>
<html lang="es" class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Ignacio Mello" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col relative overflow-x-hidden bg-slate-50 dark:bg-[#070b14] text-slate-900 dark:text-slate-100">
    <!-- Ambient Background Glow & Grid -->
    <div class="pointer-events-none fixed inset-0 z-0 bg-grid-pattern"></div>
    <div class="pointer-events-none fixed top-[-180px] left-1/2 -translate-x-1/2 w-[850px] h-[420px] bg-gradient-to-tr from-emerald-500/15 via-cyan-500/10 to-indigo-500/15 blur-[120px] rounded-full z-0"></div>

    <!-- Sticky Glassmorphism Navbar -->
    <header class="sticky top-0 z-50 border-b border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-[#070b14]/80 backdrop-blur-xl">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <!-- Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-cyan-600 flex items-center justify-center text-white font-mono font-bold text-sm shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform">
            IM
          </div>
          <div class="flex flex-col">
            <span class="font-bold tracking-tight text-slate-900 dark:text-white leading-none flex items-center gap-1.5">
              Ignacio Mello
              <span class="text-emerald-500 font-mono text-xs">&gt;_</span>
            </span>
            <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mt-0.5">
              Backend &amp; Fullstack Dev
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 bg-slate-100/80 dark:bg-slate-900/80 p-1 rounded-full border border-slate-200/70 dark:border-slate-800">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200',
                isActive(item.href)
                  ? 'bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-sm'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Actions (Social + Theme Toggle + Mobile Menu Button) -->
        <div class="flex items-center gap-2">
          <a
            href="https://github.com/IgnacioHM112"
            target="_blank"
            rel="noopener"
            aria-label="GitHub de Ignacio Mello"
            class="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition"
            title="GitHub (@IgnacioHM112)"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/ignacio-mello-b75204405/"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn de Ignacio Mello"
            class="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition"
            title="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
          </a>

          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Cambiar tema claro/oscuro"
            class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/80 transition"
            title="Cambiar tema"
          >
            <!-- Sun icon (visible in dark mode) -->
            <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon icon (visible in light mode) -->
            <svg class="w-4 h-4 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Mobile menu trigger -->
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Abrir menú"
            class="md:hidden p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <nav id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-[#070b14]/95 px-6 py-4 space-y-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block px-4 py-2 rounded-lg text-sm font-medium transition',
              isActive(item.href)
                ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold'
                : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <!-- Main Content -->
    <div class="relative z-10 flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Global Professional Footer -->
    <footer class="relative z-10 border-t border-slate-200/80 dark:border-slate-800/80 bg-white/60 dark:bg-[#050811]/80 backdrop-blur-md mt-20">
      <div class="max-w-6xl mx-auto px-6 py-12">
        <div class="grid gap-8 md:grid-cols-3 items-start pb-8 border-b border-slate-200/70 dark:border-slate-800/70">
          <div>
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-emerald-500 to-cyan-600 flex items-center justify-center text-white font-mono font-bold text-xs">
                IM
              </div>
              <span class="font-bold text-slate-900 dark:text-white">Ignacio Mello</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xs leading-relaxed">
              Desarrollador Backend &amp; Fullstack enfocado en sistemas de gestión, APIs escalables e integraciones inteligentes. Estudiante de Sistemas en la Universidad del Aconcagua.
            </p>
          </div>

          <div class="flex flex-col gap-2 text-sm">
            <span class="font-semibold text-slate-900 dark:text-white mb-1">Navegación</span>
            <a href="/" class="text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition">Inicio</a>
            <a href="/projects" class="text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition">Proyectos (6)</a>
            <a href="/about" class="text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition">Sobre mí &amp; Trayectoria</a>
            <a href="/blog" class="text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition">Blog Técnico</a>
          </div>

          <div class="flex flex-col gap-2 text-sm">
            <span class="font-semibold text-slate-900 dark:text-white mb-1">Contacto directo</span>
            <p class="text-slate-600 dark:text-slate-400 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Mendoza, Argentina (UTC-3)
            </p>
            <a href="mailto:ignamello2002@gmail.com" class="text-slate-600 dark:text-slate-400 hover:text-emerald-500 font-mono text-xs transition">
              ignamello2002@gmail.com
            </a>
            <div class="flex gap-4 mt-2">
              <a href="https://github.com/IgnacioHM112" target="_blank" rel="noopener" class="text-slate-600 dark:text-slate-400 hover:text-emerald-500 font-medium transition">
                GitHub ↗
              </a>
              <a href="https://www.linkedin.com/in/ignacio-mello-b75204405/" target="_blank" rel="noopener" class="text-slate-600 dark:text-slate-400 hover:text-emerald-500 font-medium transition">
                LinkedIn ↗
              </a>
            </div>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500 dark:text-slate-500">
          <p>© {new Date().getFullYear()} Ignacio Mello (@IgnacioHM112). Todos los derechos reservados.</p>
          <p class="font-mono">Construido con Astro • Tailwind CSS • TypeScript</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>